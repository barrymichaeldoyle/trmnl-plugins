{%- comment -%}
  A narrow, tall column: everything stacks, with a summary on top and one
  column of list items beneath. Short lists use larger type.
{%- endcomment -%}
{%- comment -%}
  list_cap keeps every list within what TRMNL X can show. Framework 3.4's overflow
  engine measures X's scaled screen in mixed units and under-trims there; on
  OG it still trims the rest and counts what it hides.
{%- endcomment -%}
{%- assign list_cap = 9 -%}
{%- assign item_count = 0 -%}
{%- case screen -%}
  {%- when 'daily_tasks' -%}{%- for group in groups -%}{%- assign item_count = item_count | plus: group.tasks.size -%}{%- endfor -%}
  {%- when 'due_tasks' -%}{%- assign item_count = tasks.size -%}
  {%- when 'pinned_note' -%}{%- assign item_count = lines.size -%}
{%- endcase -%}
{%- if item_count <= 9 -%}
  {%- assign text_class = 'title lg:title--xlarge' -%}
  {%- assign box_class = 'w--5 h--5 lg:w--7 lg:h--7' -%}
{%- else -%}
  {%- assign text_class = 'title title--small lg:title' -%}
  {%- assign box_class = 'w--4 h--4 lg:w--6 lg:h--6' -%}
{%- endif -%}
{%- assign bar_heights = '1,4,7,10,12,16,20,24,28' | split: ',' -%}
{%- assign bar_heights_lg = '1,6,12,16,24,28,36,40,48' | split: ',' -%}
<div class="layout layout--col layout--stretch-x layout--top gap">
  {% if message_title != blank %}
    <div class="flex flex--col flex--center gap--small h--full">
      <span class="value value--small lg:value--base text--center">{{ message_title }}</span>
      <p class="description description--xlarge lg:description--xxlarge text--center">{{ message_text }}</p>
    </div>
  {% else %}
    {% case screen %}
      {% when 'daily_tasks' %}
        <div class="flex flex--col flex--left w--full">
          <span class="title lg:title--xlarge">{{ date_label | escape }}</span>
          {% if total > 0 %}<span class="label lg:label--large">{{ done }} of {{ total }} done</span>{% endif %}
        </div>
        {% if total > 0 %}
          <div class="columns" data-overflow="true" data-overflow-max-cols="1" data-overflow-counter="true">
            <div class="column">
              {% assign shown = 0 %}

              {% for group in groups %}
                {% if group.heading != blank and shown < list_cap %}<span class="label label--underline group-header" data-group-header="true">{{ group.heading | escape }}</span>{% endif %}
                {% for task in group.tasks %}{% if shown < list_cap %}{% assign shown = shown | plus: 1 %}
                  <div class="item{% if task.sub %} pl--6{% endif %}"><div class="content grow"><div class="flex flex--top gap--small w--full"><span class="{{ text_class }} flex flex--center-y no-shrink">&#8203;<img class="image no-shrink {{ box_class }}" src="{% if task.done %}{{ check_uri }}{% else %}{{ box_uri }}{% endif %}" alt="{% if task.done %}Done{% else %}Open{% endif %}"></span><span class="{{ text_class }}{% if task.done %} text--gray-45{% endif %} w--full" data-clamp="2">{{ task.text | escape }}</span></div></div></div>
                {% endif %}{% endfor %}
              {% endfor %}
            </div>
          </div>
        {% else %}
          <p class="value value--small lg:value--base">Today’s note has no checkboxes yet.</p>
        {% endif %}

      {% when 'due_tasks' %}
        <div class="grid grid--cols-3 gap--small w--full">
          <div class="flex flex--col flex--left"><span class="value value--base lg:value--large value--tnums">{{ overdue_count }}</span><span class="label label--small lg:label">Overdue</span></div>
          <div class="flex flex--col flex--left"><span class="value value--base lg:value--large value--tnums">{{ today_count }}</span><span class="label label--small lg:label">Today</span></div>
          <div class="flex flex--col flex--left"><span class="value value--base lg:value--large value--tnums">{{ upcoming_count }}</span><span class="label label--small lg:label">{{ lookahead_days }} days</span></div>
        </div>
        {% if tasks.size > 0 %}
          {% assign current = '' %}
          <div class="columns grow" data-overflow="true" data-overflow-max-cols="1" data-overflow-counter="true">
            <div class="column">
              {% for task in tasks limit: list_cap %}
                {% if task.bucket != current %}
                  {% assign current = task.bucket %}
                  <span class="label label--underline group-header" data-group-header="true">{% case task.bucket %}{% when 'overdue' %}Overdue{% when 'today' %}Due today{% else %}Coming up{% endcase %}</span>
                {% endif %}
                <div class="item"><div class="content grow"><div class="flex flex--col flex--left w--full">
                  <span class="title title--small lg:title w--full" data-clamp="2">{{ task.text | escape }}</span>
                  <span class="label label--small lg:label w--full" data-clamp="1">{{ task.file | escape }}{% if task.bucket == 'overdue' %} · {{ task.when | escape }}{% elsif task.bucket == 'upcoming' %} · {{ task.due_label | escape }}{% endif %}</span>
                </div></div></div>
              {% endfor %}
            </div>
          </div>
        {% else %}
          <p class="value value--small lg:value--base">Nothing due in the next {{ lookahead_days }} days.</p>
        {% endif %}

      {% when 'dataview_query' %}
        {% assign shown_rows = rows.size | at_most: 6 %}
        <div class="flex flex--col flex--left w--full">
          <span class="title lg:title--xlarge w--full" data-clamp="2">{{ title | escape }}</span>
          {% if row_count > shown_rows %}<span class="label lg:label--large">{{ shown_rows }} of {{ row_count }}</span>{% endif %}
        </div>
        {% if rows.size > 0 %}
          <table class="table lg:table--large">
            {% if kind == 'table' %}<thead><tr>{% for header in headers limit: 2 %}<th><span class="title title--small lg:title pr--4">{{ header | escape }}</span></th>{% endfor %}</tr></thead>{% endif %}
            <tbody>
              {% for row in rows limit: 6 %}<tr>{% for cell in row limit: 2 %}<td><span class="label lg:label--large pr--4 w--full" data-clamp="1">{{ cell | escape }}</span></td>{% endfor %}</tr>{% endfor %}
            </tbody>
          </table>
        {% else %}
          <p class="value value--small lg:value--base">The query has no results.</p>
        {% endif %}

      {% when 'resurface' %}
        <div class="flex flex--col gap--xsmall w--full">
          <span class="title title--large lg:title--xxlarge w--full" data-clamp="3">{{ title | escape }}</span>
          <span class="label lg:label--large w--full" data-clamp="2">{{ age_label | escape }} · {{ word_count }} words</span>
        </div>
        <div class="richtext richtext--left w--full grow">
          <div class="content content--large lg:content--xlarge gap" data-content-limiter="true">
            {% for paragraph in paragraphs %}<p>{{ paragraph | escape }}</p>{% endfor %}
          </div>
        </div>

      {% when 'writing_stats' %}
        <div class="grid grid--cols-2 portrait:grid--cols-1 gap w--full">
          <div class="flex flex--col flex--left"><span class="value value--xlarge lg:value--xxlarge value--tnums">{{ labels.words_today }}</span><span class="label lg:label--large">Words today</span></div>
          <div class="flex flex--col flex--left"><span class="value value--xlarge lg:value--xxlarge value--tnums">{{ streak_days }}</span><span class="label lg:label--large">Day streak</span></div>
        </div>
        <div class="flex flex--col flex--stretch-x gap--small w--full grow">
          <span class="label lg:label--large">Last {{ history.size }} days</span>
          <div class="flex flex--row flex--bottom gap--xsmall w--full grow">
            {% for day in history %}
              <div class="flex flex--col flex--bottom flex--center-x gap--xsmall grow h--full">
                <div class="w--full h--{{ bar_heights[day.level] }} lg:h--{{ bar_heights_lg[day.level] }} bg--black"></div>
                <span class="label label--small{% if day.today %} label--inverted{% endif %}">{{ day.label }}</span>
              </div>
            {% endfor %}
          </div>
          <span class="label label--small lg:label">{{ labels.total_words }} words in {{ labels.total_notes }} notes</span>
        </div>

      {% when 'pinned_note' %}
        <span class="title title--large lg:title--xxlarge w--full" data-clamp="2">{{ title | escape }}</span>
        <div class="columns grow" data-overflow="true" data-overflow-max-cols="1" data-overflow-counter="true">
          <div class="column">
            {% for line in lines limit: list_cap %}
              {% case line.kind %}
                {% when 'heading' %}
                  <span class="label label--underline group-header" data-group-header="true">{{ line.text | escape }}</span>
                {% when 'pair' %}
                  <div class="item"><div class="content grow"><div class="flex flex--col flex--left w--full"><span class="label lg:label--large">{{ line.label | escape }}</span><span class="{{ text_class }} w--full" data-clamp="2">{{ line.text | escape }}</span></div></div></div>
                {% when 'task' %}
                  <div class="item{% if line.sub %} pl--6{% endif %}"><div class="content grow"><div class="flex flex--top gap--small w--full"><span class="{{ text_class }} flex flex--center-y no-shrink">&#8203;<img class="image no-shrink {{ box_class }}" src="{% if line.done %}{{ check_uri }}{% else %}{{ box_uri }}{% endif %}" alt="{% if line.done %}Done{% else %}Open{% endif %}"></span><span class="{{ text_class }}{% if line.done %} text--gray-45{% endif %} w--full" data-clamp="2">{{ line.text | escape }}</span></div></div></div>
                {% when 'li' %}
                  <div class="item{% if line.sub %} pl--6{% endif %}"><div class="content grow"><div class="flex flex--col flex--left w--full"><span class="{{ text_class }} w--full" data-clamp="2">{{ line.text | escape }}</span></div></div></div>
                {% else %}
                  <div class="item"><div class="content grow"><div class="flex flex--col flex--left w--full"><span class="description lg:description--xlarge w--full" data-clamp="4">{{ line.text | escape }}</span></div></div></div>
              {% endcase %}
            {% endfor %}
          </div>
        </div>
    {% endcase %}
  {% endif %}
</div>
<div class="title_bar">
  <img class="image" src="{{ icon_uri }}" alt="">
  <span class="title" data-footer-name="true">{{ plugin_name }}</span>
  {% if bar_detail != blank %}<span class="instance portrait:hidden">{{ bar_detail }}</span>{% endif %}
</div>
