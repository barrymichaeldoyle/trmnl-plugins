{%- comment -%}
  Shared runs before each view. The Obsidian plugin pushes one screen's data:
  screen names the layout, vault and updated fill the title bar, and status is
  ok or names what the screen should explain instead. Every string arrives as
  plain text with emoji removed; numbers the screen shows arrive formatted.
{%- endcomment -%}
{%- assign plugin_name = trmnl.plugin_settings.instance_name | default: 'Obsidian' | escape -%}
{%- assign bar_detail = '' -%}
{%- if updated != blank -%}
  {%- capture bar_detail -%}{{ vault | escape }} · {{ updated | escape }}{%- endcapture -%}
{%- endif -%}
{%- assign known_screens = 'daily_tasks,due_tasks,dataview_query,resurface,writing_stats,pinned_note' | split: ',' -%}
{%- assign message_title = '' -%}
{%- assign message_text = message | escape -%}
{%- if screen == blank -%}
  {%- assign message_title = 'Waiting for Obsidian' -%}
  {%- assign message_text = 'Paste this plugin’s webhook URL into a screen in the TRMNL Screens settings in Obsidian. The first push replaces this message.' -%}
{%- elsif known_screens contains screen -%}
  {%- if status != 'ok' -%}
    {%- assign message_title = 'Screen unavailable' -%}
    {%- if screen == 'daily_tasks' and status == 'missing' -%}{%- assign message_title = 'No daily note yet' -%}
    {%- elsif screen == 'pinned_note' -%}{%- assign message_title = 'Pinned note' -%}
    {%- elsif screen == 'resurface' and status == 'empty' -%}{%- assign message_title = 'Nothing to resurface' -%}
    {%- elsif screen == 'dataview_query' -%}{%- assign message_title = title | default: 'Dataview query' | escape -%}
    {%- endif -%}
    {%- if message_text == blank -%}{%- assign message_text = 'Obsidian could not read this screen. The next push will try again.' -%}{%- endif -%}
  {%- endif -%}
{%- else -%}
  {%- assign message_title = 'Update this recipe' -%}
  {%- assign message_text = 'Obsidian sent a screen this version of the recipe does not know. Install the latest Obsidian Screens recipe.' -%}
{%- endif -%}

{%- comment -%}A note page with a ticked checkbox: the listing icon in black and white.{%- endcomment -%}
{%- capture icon_svg -%}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path fill="none" stroke="black" stroke-width="2" stroke-linejoin="round" d="M6 2.5h8.5l4.5 4.5v13a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 5 20V4a1.5 1.5 0 0 1 1-1.5zM14.5 2.5V7H19"/><path fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M8 13l2 2 4-4.5M8 18.5h8"/></svg>{%- endcapture -%}
{%- assign icon_uri = icon_svg | base64_encode | prepend: 'data:image/svg+xml;base64,' -%}
{%- comment -%}Checkboxes are drawn, never emoji: an empty square, and a filled one with a tick.{%- endcomment -%}
{%- capture box_svg -%}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><rect x="2" y="2" width="16" height="16" rx="3" fill="none" stroke="black" stroke-width="2.5"/></svg>{%- endcapture -%}
{%- capture check_svg -%}<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><rect x="1" y="1" width="18" height="18" rx="3" fill="black"/><path d="M5.5 10.5l3 3 6-7" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endcapture -%}
{%- assign box_uri = box_svg | base64_encode | prepend: 'data:image/svg+xml;base64,' -%}
{%- assign check_uri = check_svg | base64_encode | prepend: 'data:image/svg+xml;base64,' -%}
