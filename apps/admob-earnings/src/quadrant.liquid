{%- comment -%}The primary figure with the three secondary amounts in a row beneath it; portrait stacks them.{%- endcomment -%}
<div class="layout layout--col layout--stretch-x layout--center-y gap{{ appearance_class }}" data-appearance="{{ appearance }}">
  {% if status == 'ok' %}
      <div class="flex flex--col flex--center-y flex--left gap--small" data-tile="{{ primary.key }}">
        <span class="title title--small">{{ primary.label | escape }}</span>
        <span class="value {{ amount_classes.primary.quadrant }} value--tnums" data-amount="true">{{ primary.amount | escape }}</span>
      </div>
    <div class="grid grid--cols-3 portrait:grid--cols-1 gap--small w--full">
      {% for tile in secondary %}
        <div class="flex flex--col flex--left" data-tile="{{ tile.key }}">
          <span class="label label--small">{{ tile.label | escape }}</span>
          <div class="flex flex--col flex--left gap--xsmall">
            <span class="value {{ amount_classes.secondary.quadrant }} value--tnums" data-amount="true">{{ tile.amount_short | escape }}</span>
            {% if tile.comparison_short != blank %}<span class="hidden portrait:flex lg:flex flex--row flex--center-y gap--xsmall" data-direction="{{ tile.direction }}">{% if tile.direction == 'up' %}<img class="image w--3 h--3 no-shrink" src="{{ arrow_up_uri }}" alt="Up">{% elsif tile.direction == 'down' %}<img class="image w--3 h--3 no-shrink" src="{{ arrow_down_uri }}" alt="Down">{% endif %}<span class="label label--small">{{ tile.comparison_short | escape }}</span></span>{% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <p class="value value--xsmall lg:value--small text--center">{{ message_text }}</p>
  {% endif %}
</div>
<div class="title_bar{{ appearance_class }}" data-appearance="{{ appearance }}">
  <img class="image" src="{{ icon_uri }}" alt="">
  <span class="title" data-footer-name="true">{{ plugin_name }}</span>
  {% if bar_detail %}<span class="instance portrait:hidden">{{ bar_detail }}</span>{% endif %}
</div>
