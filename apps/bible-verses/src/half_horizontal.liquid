<div class="layout layout--col layout--top relative{{ appearance_class }}" data-appearance="{{ appearance }}" lang="{{ selected_translation.language | escape }}" translate="no" data-theme="{{ theme_label }}">
  {% if verse %}
    <div class="relative flex flex--col flex--between flex--left gap--small w--full h--full">
      <div class="flex hidden portrait:flex flex--row flex--center-x w--full h--20 lg:h--24 no-shrink">
        <img class="image image-dither image--contain w--auto h--full" src="{{ hero_cross_uri }}" alt="Christian cross" data-reading-cross="true">
      </div>
      <div class="flex flex--col flex--center-y flex--left grow w--full h--0 gap--small" data-reading-area="true">
        <p class="value no-shrink value--large lg:value--xxlarge daily-bread-scripture w--min-full" lang="{{ selected_translation.language | escape }}" data-scripture-fit="true" data-value-fit="true" data-value-fit-max-height="{{ banner_text_height }}" data-verse-id="{{ verse.id | escape }}"><span class="daily-bread-cross w--[6cqw] lg:w--[9cqw] portrait:hidden ml--2 h--0" data-cross-wrap="true" aria-hidden="true"></span>{% if context_qr %}<span class="daily-bread-qr-push w--0 h--0" data-qr-push="true" aria-hidden="true"></span><span class="daily-bread-qr-wrap w--0 h--0" data-qr-wrap="true" aria-hidden="true"></span>{% endif %}{{ verse.text | escape }}</p>
        <p class="title title--base lg:title--large no-shrink w--full" data-content-reference="true">{{ verse.reference | escape }}</p>
      </div>
      <div class="absolute top--0 right--0 flex flex--col flex--center-x gap--small" data-pinned-cross="true">
        <div class="w--[6cqw] lg:w--[9cqw] portrait:hidden"><img class="image image-dither image--contain w--full h--auto" src="{{ hero_cross_uri }}" alt="Christian cross" data-reading-cross="true"></div>
      </div>
      {%- comment -%}As in the full view, the QR sits in the bottom-right corner above the title bar. The cross and QR anchor to this content box, inside the mashup padding.{%- endcomment -%}
      {% if context_qr %}{{ context_qr | replace: 'w--24 h--24 p--3', 'w--16 h--16 p--1 portrait:w--24 portrait:h--24 portrait:p--3' }}{% endif %}
    </div>
  {% else %}
    <p class="description">{{ missing_text | escape }}</p>
  {% endif %}
</div>
<div class="title_bar{{ appearance_class }}" data-appearance="{{ appearance }}" translate="no">
  <img class="image" src="{{ hero_cross_uri }}" alt="" data-plugin-icon="true">
  <div class="flex flex--left grow w--0">
    {% if verse %}<span class="title hidden" data-value-fit="true" data-footer-reference="true" title="{{ selected_translation.name | escape }} ({{ selected_translation.abbreviation | escape }})">{{ verse.reference | escape }}</span>{% endif %}<span class="title" data-value-fit="true" data-footer-name="true">{{ trmnl.plugin_settings.instance_name | default: 'Daily Bread' | escape }}</span>
  </div>
</div>
