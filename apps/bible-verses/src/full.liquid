<div class="layout layout--col layout--top{{ appearance_class }}" data-appearance="{{ appearance }}" lang="{{ selected_translation.language | escape }}" translate="no" data-theme="{{ theme_label }}">
  {% if verse %}
    <div class="flex flex--col flex--between w--full h--full gap--small">
      <div class="flex flex--col flex--center-y flex--left grow w--full h--0" data-reading-area="true">
        <p class="value no-shrink value--large lg:value--xxlarge w--min-full" lang="{{ selected_translation.language | escape }}" data-scripture-fit="true" data-value-fit="true" data-value-fit-max-height="{{ full_text_height }}" data-verse-id="{{ verse.id | escape }}">{{ verse.text | escape }}</p>
      </div>
      {%- comment -%}The passage keeps the full width. A footer row holds the chapter QR code at the left, the book and the chapter and verses in the middle, and the cross at the right, as tall as the code.{%- endcomment -%}
      <div class="flex flex--row flex--between flex--center-y no-shrink w--full gap" data-reading-footer="true">
        {% if context_qr %}{{ context_qr | replace: 'w--24 h--24', 'w--24 h--24 portrait:w--32 portrait:h--32 lg:w--48 lg:h--48' }}{% else %}<span class="w--0 h--0" aria-hidden="true"></span>{% endif %}
        <div class="flex flex--col flex--center grow w--0 text--center" data-row-reference="true">
          <div class="flex flex--center-x w--full"><span class="value value--small lg:value--base no-shrink" data-value-fit="true">{{ reference_book | escape }}</span></div>
          <div class="flex flex--center-x w--full"><span class="value value--base lg:value--large no-shrink" data-value-fit="true">{{ reference_verses | escape }}</span></div>
        </div>
        <div class="h--24 portrait:h--32 lg:h--48 no-shrink" data-pinned-cross="true"><img class="image image--contain h--full w--auto" src="{{ hero_cross_uri }}" alt="Christian cross" data-reading-cross="true"></div>
      </div>
    </div>
  {% else %}
    <span class="title">{{ missing_title | escape }}</span>
    <p class="description">{{ missing_text | escape }}</p>
  {% endif %}
</div>
<div class="title_bar{{ appearance_class }}" data-appearance="{{ appearance }}" translate="no">
  <img class="image" src="{{ hero_cross_uri }}" alt="" data-plugin-icon="true">
  <div class="flex flex--left flex--center-y grow w--0 gap--small">
    <span class="title" data-value-fit="true" data-footer-name="true">{{ trmnl.plugin_settings.instance_name | default: 'Daily Bread' | escape }}</span>
    <span class="instance" title="{{ selected_translation.name | escape }} ({{ selected_translation.abbreviation | escape }})">{{ selected_translation.name | escape }}</span>
  </div>
</div>
