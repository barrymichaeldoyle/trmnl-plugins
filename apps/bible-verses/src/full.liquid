<div class="layout layout--col layout--top{{ appearance_class }}" data-appearance="{{ appearance }}" lang="{{ selected_translation.language | escape }}" translate="no" data-theme="{{ theme_label }}">
  {% if verse %}
    <div class="flex flex--row flex--between flex--top w--full h--full gap">
      <div class="flex flex--col flex--center-y flex--left grow w--0 h--full" data-reading-area="true">
        <p class="value no-shrink value--large lg:value--xxlarge w--min-full" lang="{{ selected_translation.language | escape }}" data-scripture-fit="true" data-value-fit="true" data-value-fit-max-height="{{ full_text_height }}" data-verse-id="{{ verse.id | escape }}">{{ verse.text | escape }}</p>
      </div>
      {%- comment -%}The artwork column is as wide as the chapter QR code, top right, so the passage keeps the rest of the width. A card between the code and the cross names the passage; the cross sits at the bottom.{%- endcomment -%}
      <div class="flex flex--col flex--between flex--right no-shrink h--full gap--small">
        {% if context_qr %}{{ context_qr | replace: 'w--24 h--24', 'w--32 h--32 lg:w--40 lg:h--40' }}{% else %}<span class="h--0" aria-hidden="true"></span>{% endif %}
        <div class="outline p--2 w--0 w--min-full" data-column-reference="true">
          <div class="flex flex--center-x w--full"><span class="value value--xsmall lg:value--small no-shrink" data-value-fit="true">{{ reference_book | escape }}</span></div>
          <div class="flex flex--center-x w--full"><span class="value value--small lg:value--base no-shrink" data-value-fit="true">{{ reference_verses | escape }}</span></div>
        </div>
        <div class="w--[13cqw] portrait:w--[28cqw] lg:portrait:w--[17cqw]" data-pinned-cross="true"><img class="image image--contain w--full h--auto" src="{{ hero_cross_uri }}" alt="Christian cross" data-reading-cross="true"></div>
      </div>
    </div>
  {% else %}
    <span class="title">{{ missing_title | escape }}</span>
    <p class="description">{{ missing_text | escape }}</p>
  {% endif %}
</div>
<div class="title_bar{{ appearance_class }}" data-appearance="{{ appearance }}" translate="no">
  <img class="image" src="{{ hero_cross_uri }}" alt="" data-plugin-icon="true">
  <div class="flex flex--left flex--center-y grow w--0 gap--small">
    {% if verse %}<span class="title hidden" data-value-fit="true" data-footer-reference="true" title="{{ selected_translation.name | escape }} ({{ selected_translation.abbreviation | escape }})">{{ verse.reference | escape }}</span>{% endif %}<span class="title" data-value-fit="true" data-footer-name="true">{{ trmnl.plugin_settings.instance_name | default: 'Daily Bread' | escape }}</span>
    <span class="instance" title="{{ selected_translation.name | escape }} ({{ selected_translation.abbreviation | escape }})">{{ selected_translation.name | escape }}</span>
  </div>
</div>
