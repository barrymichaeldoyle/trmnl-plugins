<div class="layout layout--col layout--top relative" lang="{{ selected_translation.language | escape }}" translate="no" data-theme="{{ theme_label }}">
  {% if verse %}
    <div class="flex flex--col flex--between flex--left gap--small w--full h--full">
      <div class="flex flex--col flex--center-y flex--left grow w--full h--0" data-reading-area="true">
        <p class="value no-shrink value--large lg:value--xxlarge daily-bread-scripture w--min-full" lang="{{ selected_translation.language | escape }}" data-scripture-fit="true" data-value-fit="true" data-value-fit-max-height="{{ small_text_height }}" data-verse-id="{{ verse.id | escape }}"><span class="daily-bread-cross {% if context_qr %}w--16{% else %}w--12 lg:w--14{% endif %} ml--2 h--0" data-cross-wrap="true" aria-hidden="true"></span>{{ verse.text | escape }}</p>
      </div>
      {% if context_qr %}<div class="hidden portrait:block w--full h--16 no-shrink" aria-hidden="true"></div>{% endif %}
    </div>
    <div class="absolute top--0 right--0 flex flex--col flex--center-x gap--small" data-pinned-cross="true">
      <div class="w--12 lg:w--14"><img class="image image--contain w--full h--auto" src="{{ hero_cross_uri }}" alt="Christian cross" data-reading-cross="true"></div>
      {% if context_qr %}{{ context_qr | replace: 'absolute bottom--0 right--0 block', 'block portrait:hidden' | replace: 'w--24 h--24 p--3', 'w--16 h--16 p--1' }}{% endif %}
    </div>
    {%- comment -%}Narrow portrait columns keep the QR below the passage instead of beside it.{%- endcomment -%}
    {% if context_qr %}{{ context_qr | replace: 'absolute bottom--0 right--0 block', 'hidden portrait:block absolute bottom--0 right--0' | replace: 'w--24 h--24 p--3', 'w--16 h--16 p--1' }}{% endif %}
  {% else %}
    <p class="description description--small">{{ missing_text | escape }}</p>
  {% endif %}
</div>
<div class="title_bar" translate="no">
  <div class="flex flex--left grow w--0">
    <span class="title" data-value-fit="true" data-footer-reference="true" title="{{ selected_translation.name | escape }} ({{ selected_translation.abbreviation | escape }})">{% if verse %}{{ verse.reference | escape }}{% else %}{{ trmnl.plugin_settings.instance_name | default: 'Daily Bread' | escape }}{% endif %}</span>
  </div>
</div>
